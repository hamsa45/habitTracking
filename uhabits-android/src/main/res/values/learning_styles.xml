<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JavaLearning" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/learning_primary</item>
        <item name="colorPrimaryDark">@color/learning_primary_dark</item>
        <item name="colorAccent">@color/learning_primary</item>
        <item name="colorSecondary">@color/learning_secondary</item>
        <item name="android:colorBackground">@color/learning_bg</item>
        <item name="android:statusBarColor">@color/learning_bg</item>
        <item name="android:navigationBarColor">@color/learning_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/learning_secondary</item>
        <item name="android:textColorSecondary">@color/learning_neutral</item>
        <item name="materialButtonStyle">@style/Widget.JavaLearning.Button.Primary</item>
        <item name="bottomNavigationStyle">@style/Widget.JavaLearning.BottomNav</item>
    </style>

    <style name="Widget.JavaLearning.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/learning_inter</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/learning_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/learning_on_primary</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.JavaLearning.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/learning_inter</item>
        <item name="strokeColor">@color/learning_primary_soft_2</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/learning_primary</item>
        <item name="backgroundTint">@color/learning_primary_soft</item>
    </style>

    <style name="Widget.JavaLearning.Button.Soft" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/learning_inter</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/learning_primary_soft</item>
        <item name="android:textColor">@color/learning_primary</item>
    </style>

    <style name="Widget.JavaLearning.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/learning_bottom_nav_color</item>
        <item name="itemTextColor">@color/learning_bottom_nav_color</item>
        <item name="itemRippleColor">@color/learning_primary_soft</item>
        <item name="elevation">8dp</item>
        <item name="backgroundTint">@color/learning_surface</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Text.JavaLearning.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/learning_manrope</item>
        <item name="android:textColor">@color/learning_secondary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.JavaLearning.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/learning_manrope</item>
        <item name="android:textColor">@color/learning_secondary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.JavaLearning.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/learning_inter</item>
        <item name="android:textColor">@color/learning_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.JavaLearning.Meta" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/learning_inter</item>
        <item name="android:textColor">@color/learning_neutral</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Text.JavaLearning.Mono" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/learning_mono</item>
        <item name="android:textColor">@color/learning_primary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text.JavaLearning.SectionLabel" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:fontFamily">@font/learning_inter</item>
        <item name="android:textColor">@color/learning_neutral</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
