<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/learning_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/topicCategoryChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/learning_chip_bg"
            android:fontFamily="@font/learning_inter"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/learning_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/topicStatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/learning_chip_bg"
            android:fontFamily="@font/learning_inter"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/learning_neutral"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/topicReviewChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/learning_chip_warning_bg"
            android:fontFamily="@font/learning_inter"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/learning_tertiary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/topicName"
        style="@style/Text.JavaLearning.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/topicMasteryDots"
        style="@style/Text.JavaLearning.Mono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/learning_primary" />

    <TextView
        android:id="@+id/topicFooter"
        style="@style/Text.JavaLearning.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />
</LinearLayout>
