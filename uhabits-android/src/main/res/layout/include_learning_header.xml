<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/learning_code_badge_bg">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_learning_code" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/learning_manrope"
            android:text="@string/app_name"
            android:textColor="@color/learning_secondary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/learningHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/learning_inter"
            android:textColor="@color/learning_neutral"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/learningOfflineBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/learning_offline_bg"
        android:fontFamily="@font/learning_inter"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/learning_offline"
        android:textColor="@color/learning_offline"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
