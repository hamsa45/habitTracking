<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/learning_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <include
            android:id="@+id/historyHeader"
            layout="@layout/include_learning_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/learning_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.JavaLearning.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/learning_this_weeks_study"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/historyWeekBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/learning_chip_bg"
                    android:fontFamily="@font/learning_mono"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/learning_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/historyWeekMinutes"
                style="@style/Text.JavaLearning.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="26sp" />

            <ProgressBar
                android:id="@+id/historyWeekProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressDrawable="@drawable/learning_horizontal_progress" />

            <TextView
                android:id="@+id/historyWeekMeta"
                style="@style/Text.JavaLearning.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/historyPaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/learning_card_soft_bg"
                android:fontFamily="@font/learning_inter"
                android:padding="12dp"
                android:textColor="@color/learning_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/learning_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.JavaLearning.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/learning_study_rhythm"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/historyCurrentStreak"
                        style="@style/Text.JavaLearning.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/Text.JavaLearning.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current streak" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/historyLongestStreak"
                        style="@style/Text.JavaLearning.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/Text.JavaLearning.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Longest streak" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/learning_rest_soft_bg"
                android:fontFamily="@font/learning_inter"
                android:padding="12dp"
                android:text="@string/learning_pace_hint"
                android:textColor="@color/learning_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/learning_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.JavaLearning.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/learning_consistency_grid"
                android:textSize="16sp" />

            <TextView
                style="@style/Text.JavaLearning.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Past 28 days of study focus" />

            <GridLayout
                android:id="@+id/historyHeatmap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alignmentMode="alignMargins"
                android:columnCount="7"
                android:useDefaultMargins="true" />

            <TextView
                android:id="@+id/historyHeatmapFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/learning_card_soft_bg"
                android:fontFamily="@font/learning_mono"
                android:padding="10dp"
                android:textColor="@color/learning_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            style="@style/Text.JavaLearning.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/learning_curriculum_health"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/historyHealthInProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/learning_card_bg"
                android:fontFamily="@font/learning_inter"
                android:padding="12dp"
                android:textColor="@color/learning_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/historyHealthMastered"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/learning_card_bg"
                android:fontFamily="@font/learning_inter"
                android:padding="12dp"
                android:textColor="@color/learning_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/historyHealthReview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/learning_card_bg"
                android:fontFamily="@font/learning_inter"
                android:padding="12dp"
                android:textColor="@color/learning_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/Text.JavaLearning.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/learning_recent_sessions"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/historySessionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/historyEmptyText"
            style="@style/Text.JavaLearning.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/learning_no_sessions_empty"
            android:visibility="gone" />

        <!-- legacy hidden -->
        <TextView
            android:id="@+id/historyStatsText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
