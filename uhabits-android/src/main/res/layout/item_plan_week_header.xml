<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/weekTitle"
        style="@style/Text.JavaLearning.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/weekRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/learning_chip_bg"
        android:fontFamily="@font/learning_inter"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/learning_primary"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
