<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/planDayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/learning_card_bg"
    android:orientation="horizontal"
    android:padding="14dp">

    <View
        android:id="@+id/planDayAccent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@drawable/learning_accent_bar"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/planDayBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/learning_chip_bg"
                android:fontFamily="@font/learning_inter"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/learning_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/planDayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/learning_chip_bg"
                android:fontFamily="@font/learning_inter"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/learning_neutral"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/planDayTitle"
            style="@style/Text.JavaLearning.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/planDayMeta"
            style="@style/Text.JavaLearning.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
